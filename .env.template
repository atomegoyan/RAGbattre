# RAGbattre Environment Configuration
# Copy this file to .env and customize the values

# Application Settings
PYTHONPATH=/app
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# LLM API Keys (Optional - only needed if using cloud services)
# Get these from the respective providers:
# - Mistral: https://console.mistral.ai/
# - Cohere: https://dashboard.cohere.ai/

# Mistral AI Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# Cohere Configuration  
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025

# Model Backend Selection
# Options: "ollama", "mistral", "cohere"
MODEL_BACKEND=ollama

# Ollama Configuration (requires local Ollama installation)
# Install Ollama: https://ollama.ai/download
OLLAMA_HOST=http://localhost:11434
DEFAULT_GENERATION_MODEL=llama3.2:1b

# Embedding Configuration
DEFAULT_EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base
EMBEDDING_DEVICE=cpu
RERANKING_DEVICE=cpu

# ChromaDB Configuration
DEFAULT_COLLECTION=1881-01-20

# Generation Parameters
TEMPERATURE=0.0
CTX_SIZE=10000

# File Paths (Docker defaults - usually don't need to change)
BASE_DIR=/app
DATA_DIR=/app/data
CORPUS_DIR=/app/data/corpus
EMBEDDINGS_DIR=/app/data/embeddings_cs1
EXAMPLE_QUESTIONS_FILE=/app/data/questions_strat1.jsonl

# Display Configuration
MAX_CHAR_DISPLAY=1000

# Default Query
DEFAULT_QUERY=Qui est le président de la séance ?
